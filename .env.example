# Copy to an ignored file such as .env.local and pass it explicitly.
MYGO_MODEL_BASE_URL=https://provider.example/v1
MYGO_MODEL_API_KEY=replace-me
MYGO_MODEL_ID=replace-me
MYGO_MODEL_STRUCTURED_OUTPUT_MODE=json_schema
MYGO_MODEL_PARAMETERS_JSON={"temperature":0}
MYGO_MODEL_TIMEOUT_SECONDS=120
# Optional local exporter. Omit for no-op telemetry.
# MYGO_OTEL_EXPORTER=console
